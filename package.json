{
  "name": "atlas-agent",
  "version": "4.0.0",
  "description": "Atlas Agent — Modular AI agent with Forge decision engine, Brain executor, and Shield trust system",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "run": "npm run build && npm run start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist/"
  },
  "keywords": [
    "atlas",
    "ai-agent",
    "forge",
    "brain",
    "shield"
  ],
  "author": "Marcelo",
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.7.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.0",
    "jsdom": "^29.1.1",
    "node-telegram-bot-api": "^0.66.0",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.14.0",
    "@types/node-telegram-bot-api": "^0.64.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
